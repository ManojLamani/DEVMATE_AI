# Docker Compose configuration — copy to .env and fill in your values.

# Database
POSTGRES_USER=devmate
POSTGRES_PASSWORD=devmate_secret
POSTGRES_DB=devmate

# Auth — use a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Optional: raises the GitHub API limit from 60 to 5000 requests/hour
GITHUB_TOKEN=

# Optional: enables the AI repository explainer (falls back to rule-based summaries without it)
ANTHROPIC_API_KEY=

# Host ports — change these if something else on your machine already uses them
FRONTEND_PORT=3000
BACKEND_PORT=5000
ML_PORT=8000
POSTGRES_PORT=5432

# Must match the ports above
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
